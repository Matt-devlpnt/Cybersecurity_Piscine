#!/usr/bin/env python3

##########
# Import #
##########
import argparse

###########
# Program #
###########

def parse_args():
    parser = argparse.ArgumentParser(description='stockholm - Educational ransomware simulation', prog='stockholm')
    group = parser.add_mutually_exclusive_group()
    group.add_argument('-v', '--version', action='version', version='%(prog)s 1.0')
    group.add_argument('-r', '--reverse', metavar='KEY', help='reverse the infection')
    group.add_argument('-s', '--silent', action='store_true', help='hide processed files')

    return parser.parse_args()

def main():
    try:
        args = parse_args()
    except Exception as e:
        print(f'{e}')

if __name__ == "__main__":
    main()
