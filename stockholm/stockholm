    '.sch', '.3dm', '.jsp', '.sh', '.3ds', '.key', '.sldm', '.3g2', '.lay', '.sldm', '.3gp',
    '.lay6', '.sldx', '.7z', '.ldf', '.slk', '.accdb', '.m3u', '.sln', '.aes', '.m4u', '.snt',
    '.ai', '.max', '.sql', '.ARC', '.mdb', '.sqlite3', '.asc', '.mdf', '.sqlitedb', '.asf',
    '.mid', '.stc', '.asm', '.mkv', '.std', '.asp', '.mml', '.sti', '.avi', '.mov', '.stw',
    '.backup', '.mp3', '.suo', '.bak', '.mp4', '.svg', '.bat', '.mpeg', '.swf', '.bmp', '.mpg',
    '.sxc', '.brd', '.msg', '.sxd', '.bz2', '.myd', '.sxi', '.c', '.myi', '.sxm', '.cgm', '.nef',
    '.sxw', '.class', '.odb', '.tar', '.cmd', '.odg', '.tbk', '.cpp', '.odp', '.tgz', '.crt',
    '.ods', '.tif', '.cs', '.odt', '.tiff', '.csr', '.onetoc2', '.txt', '.csv', '.ost', '.uop',
    '.db', '.otg', '.uot', '.dbf', '.otp', '.vb', '.dch', '.ots', '.vbs', '.der"', '.ott',
    '.vcd', '.dif', '.p12', '.vdi', '.dip', '.PAQ', '.vmdk', '.djvu', '.pas', '.vmx', '.docb',
