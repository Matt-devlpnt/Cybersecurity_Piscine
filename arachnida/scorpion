#!/usr/bin/env python3

##########
# Import #
##########
import argparse
from pathlib import Path
from PIL import Image, ExifTags, UnidentifiedImageError

####################
# Globale variable #
####################
BG_FILE = "\033[48;5;79m"
BG_SUB  = "\033[48;5;141m"
BG_ERR  = "\033[48;5;9m"
FG_BG   = "\033[1;38;5;236m"
FG_FILE = "\033[38;5;79m"
FG_SUB  = "\033[38;5;141m"
FG_ERR  = "\033[38;5;9m"
RESET   = "\033[0m"

###########
# Program #
###########
def show_metadata(path: str):
    p = Path(path)
    if not p.is_file():
        print(f"{BG_ERR}{FG_BG}[ERROR]{RESET}{FG_ERR} File not found: {path}{RESET}")
        return

    try:
        with Image.open(p) as img:
            print(f"\n{BG_FILE}{FG_BG} {p.name} {RESET}")
            print(f"{FG_FILE}|{RESET}")
            print(f"{FG_FILE}|{BG_SUB}{FG_BG} IMAGE ATTRIBUTES {RESET}")
            print(f"{FG_FILE}|{RESET}{FG_SUB} Path        :{RESET} {p.resolve()}")
            print(f"{FG_FILE}|{RESET}{FG_SUB} Format      :{RESET} {img.format}")
            print(f"{FG_FILE}|{RESET}{FG_SUB} Size        :{RESET} {img.width} × {img.height} px")
            print(f"{FG_FILE}|{RESET}{FG_SUB} Mode        :{RESET} {img.mode}")
            print(f"{FG_FILE}|{RESET}{FG_SUB} Animated    :{RESET} {getattr(img, 'is_animated', False)}")
            print(f"{FG_FILE}|{RESET}{FG_SUB} Frames      :{RESET} {getattr(img, 'n_frames', 1)}")

            # Additional info (dpi, icc, etc.)
            for k, v in img.info.items():
                if k.lower() != 'exif':
                    print(f"{FG_FILE}|{RESET}{FG_SUB} {k:12}:{RESET} {v}")

            # EXIF
            exif = img.getexif()
            if exif:
                print(f"{FG_FILE}|{RESET}")
                print(f"{FG_FILE}|{BG_SUB}{FG_BG} EXIF {RESET}")
                for tag_id, value in exif.items():
                    name = ExifTags.TAGS.get(tag_id, f"Unknown({tag_id})")
                    print(f"{FG_FILE}|{RESET}{FG_SUB} {name:20}:{RESET} {value}")
            else:
                print(f"{FG_FILE}|{RESET}{FG_SUB} (no EXIF data){RESET}")
            print()

    except UnidentifiedImageError:
        print(f"{BG_ERR}{FG_BG}[ERROR]{RESET}{FG_ERR} {path} is not a supported image{RESET}")
    except Exception as e:
        print(f"{BG_ERR}{FG_BG}[ERROR]{RESET}{FG_ERR} {path} → {e}{RESET}")

def main():
    parser = argparse.ArgumentParser(description="Scorpion - display image metadata")
    parser.add_argument('files', nargs='+', help="Image file(s)")
    # Ready for bonus:
    # parser.add_argument('--remove-exif', action='store_true', help="Remove EXIF metadata")
    # parser.add_argument('--set', nargs=2, metavar=('TAG', 'VALUE'), help="Modify a tag")
    args = parser.parse_args()

    for f in args.files:
        show_metadata(f)

if __name__ == "__main__":
    main()
