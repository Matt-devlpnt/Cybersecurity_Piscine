#!/usr/bin/env python3

##########
# Import #
##########
import os
import sys
import argparse
import threading
import signal
import requests
import warnings
from urllib.parse import urljoin, urlparse
from collections import defaultdict
from pathlib import Path
from bs4 import BeautifulSoup, XMLParsedAsHTMLWarning
from PIL import Image, UnidentifiedImageError

####################
# Global variables #
####################
# Colors
BG_CTRL_C    = "\033[48;5;79m"
BG_INFO      = "\033[48;5;195m"
BG_PB        = "\033[48;5;9m"
BG_TIMEOUT   = "\033[48;5;69m"
BG_REDIRECT  = "\033[48;5;192m"
BG_CONNEXION = "\033[48;5;222m"
BG_HTTP      = "\033[48;5;141m"
BG_UNKNOWN   = "\033[48;5;214m"
FG_BG        = "\033[1;38;5;236m"
FG_CTRL_C    = "\033[38;5;79m"
FG_INFO      = "\033[38;5;195m"
FG_PB        = "\033[38;5;9m"
FG_TIMEOUT   = "\033[38;5;69m"
FG_REDIRECT  = "\033[38;5;192m"
FG_CONNEXION = "\033[38;5;222m"
FG_HTTP      = "\033[38;5;141m"
FG_UNKNOWN   = "\033[38;5;214m"
RESET        = "\033[0m"

# Supported file extensions
EXTENSIONS = ('.jpg', '.jpeg', '.png', '.gif', '.bmp')

# HTML tags and attributes to parse
TAGS = {
    'a': 'href',
    'link': 'href',
    'iframe': 'src',
    'img': 'src',
    'source': 'srcset',
    'embed': 'src',
    'object': 'data',
}

###########
# Threads #
###########
# Mutex
lock = threading.Lock()
# Stop event for threads
stop_event = threading.Event()

##########
# System #
##########
# Hide ^C in terminal
os.system("stty -echoctl")

###########
# Program #
###########
def signal_handler(sig, frame):
    stop_event.set()
    print(f"{BG_CTRL_C}{FG_BG}[Ctrl+C]{RESET}{FG_CTRL_C} Stopping threads...{RESET}")

signal.signal(signal.SIGINT, signal_handler)


def unique_filepath(directory: str, filename: str) -> str:
    """Return a unique filepath, keeping the original name if possible."""
    path = os.path.join(directory, filename)
    if not os.path.exists(path):
        return path
    base, ext = os.path.splitext(filename)
    counter = 1
    while True:
        candidate = os.path.join(directory, f"{base}_{counter}{ext}")
        if not os.path.exists(candidate):
            return candidate
        counter += 1


def is_image_url(url: str) -> bool:
    return urlparse(url).path.lower().endswith(EXTENSIONS)


def image_validator(filepath: str) -> bool:
    if not os.path.exists(filepath) or os.path.getsize(filepath) == 0:
        if os.path.exists(filepath):
            os.remove(filepath)
        return False
    try:
        with Image.open(filepath) as img:
            img.verify()
        return True
    except Exception:
        if os.path.exists(filepath):
            os.remove(filepath)
        print(f"{BG_INFO}{FG_BG}[INFO]{RESET}{FG_INFO} {filepath} removed (invalid image){RESET}")
        return False


def download_image(url: str, save_dir: str):
    if stop_event.is_set():
        return
    try:
        headers = {'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36'}
        r = requests.get(url, headers=headers, stream=True, timeout=8)
        r.raise_for_status()
        filename = os.path.basename(urlparse(url).path) or "image"
        if not filename.lower().endswith(EXTENSIONS):
            # Try to guess extension from Content-Type
            ct = r.headers.get('content-type', '').lower()
            if 'jpeg' in ct or 'jpg' in ct:
                filename += '.jpg'
            elif 'png' in ct:
                filename += '.png'
            elif 'gif' in ct:
                filename += '.gif'
            elif 'bmp' in ct:
                filename += '.bmp'
            else:
                return
        filepath = unique_filepath(save_dir, filename)
        with open(filepath, 'wb') as f:
            for chunk in r.iter_content(8192):
                if stop_event.is_set():
                    break
                f.write(chunk)
        if not stop_event.is_set():
            image_validator(filepath)
    except Exception as e:
        if not stop_event.is_set():
            print(f"{BG_UNKNOWN}{FG_BG}[ERR]{RESET}{FG_UNKNOWN} {url} → {e}{RESET}")


def extract_links(base_url: str, html: bytes) -> set:
    links = set()
    try:
        soup = BeautifulSoup(html, 'lxml')
        for tag, attr in TAGS.items():
            for el in soup.find_all(tag):
                val = el.get(attr)
                if not val:
                    continue
                if attr == 'srcset':
                    # srcset = "url1 1x, url2 2x, ..."
                    parts = [p.strip().split()[0] for p in val.split(',') if p.strip()]
                    for p in parts:
                        abs_url = urljoin(base_url, p)
                        if abs_url.startswith('http'):
                            links.add(abs_url)
                else:
                    abs_url = urljoin(base_url, val)
                    if abs_url.startswith('http'):
                        links.add(abs_url)
    except Exception:
        pass
    return links


def fetch(url: str, save_dir: str, depth: int, max_depth: int, visited: set, to_visit: dict):
    if stop_event.is_set() or url in visited:
        return
    with lock:
        if url in visited:
            return
        visited.add(url)

    try:
        headers = {'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36'}
        warnings.filterwarnings("ignore", category=XMLParsedAsHTMLWarning)
        r = requests.get(url, headers=headers, timeout=8, allow_redirects=True)
        r.raise_for_status()

        if is_image_url(url) or r.headers.get('content-type', '').startswith('image/'):
            download_image(url, save_dir)
            return

        # HTML page → extract links if depth allows
        if depth < max_depth:
            new_links = extract_links(url, r.content)
            with lock:
                for link in new_links:
                    if link not in visited:
                        to_visit[link] = depth + 1
    except requests.Timeout:
        if not stop_event.is_set():
            print(f"{BG_TIMEOUT}{FG_BG}[Timeout]{RESET}{FG_TIMEOUT} {url}{RESET}")
    except requests.HTTPError as e:
        if not stop_event.is_set():
            print(f"{BG_HTTP}{FG_BG}[HTTP {e.response.status_code}]{RESET}{FG_HTTP} {url}{RESET}")
    except Exception as e:
        if not stop_event.is_set():
            print(f"{BG_UNKNOWN}{FG_BG}[ERR]{RESET}{FG_UNKNOWN} {url} → {e}{RESET}")


def spider(args):
    save_dir = args.p
    os.makedirs(save_dir, exist_ok=True)

    max_depth = args.l if args.r else 0
    visited = set()
    to_visit = {args.URL: 0}          # url → current depth

    while to_visit and not stop_event.is_set():
        # Snapshot to allow safe iteration
        current = dict(to_visit)
        to_visit.clear()

        threads = []
        for url, depth in current.items():
            if stop_event.is_set():
                break
            t = threading.Thread(target=fetch, args=(url, save_dir, depth, max_depth, visited, to_visit))
            t.start()
            threads.append(t)

        for t in threads:
            t.join()


def parse_args():
    parser = argparse.ArgumentParser(description="Spider - download images recursively")
    parser.add_argument('URL', help="Starting URL")
    parser.add_argument('-r', action='store_true', help="Recursive download")
    parser.add_argument('-l', metavar='N', type=int, default=5, help="Maximum depth level (default: 5)")
    parser.add_argument('-p', metavar='PATH', default='./data/', help="Path where files will be saved (default: ./data/)")
    return parser.parse_args()


def main():
    try:
        args = parse_args()
        if not args.URL.startswith(('http://', 'https://')):
            print(f"{BG_PB}{FG_BG}[ERROR]{RESET}{FG_PB} URL must start with http:// or https://{RESET}")
            sys.exit(1)
        spider(args)
    except Exception as e:
        print(f"{BG_PB}{FG_BG}[ERROR]{RESET}{FG_PB} {e}{RESET}")


if __name__ == "__main__":
    main()
